<?xml version="1.0"?>
<package format="2">
  <name>franka_ds</name>
  <version>1.0.0</version>
  <description>Dynamical Systems Controller for Franka Robot</description>
  <maintainer email="jason@example.com">Jason</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- 核心ROS控制依赖 -->
  <depend>controller_interface</depend>
  <depend>franka_hw</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  
  <!-- Franka相关依赖 -->
  <depend>libfranka</depend>
  <depend>franka_control</depend>
  <depend>franka_description</depend>
  <depend>franka_visualization</depend>
  
  <!-- 可视化依赖 -->
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <!-- 控制器插件 -->
    <controller_interface plugin="${prefix}/unified_ds_plugin.xml" />
  </export>
</package> 