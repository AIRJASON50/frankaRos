<?xml version="1.0" encoding="utf-8"?>
<!--
  FR3机器人独立锥形力探头定义文件
  
  作者: AIRJASON50
  日期: 2024-05-22
  
  此文件定义了FR3机器人使用的锥形力探头末端执行器。探头连接到机器人末端，
  用于感知接触力并与环境进行交互。本文件包含探头的视觉外观、物理特性
  和仿真参数。
  
  主要修改:
  1. 视觉外观使用probe_model的STL网格模型，提供真实外观
  2. 碰撞模型使用简化的圆柱体+球体组合，确保高效的物理仿真
  3. 球形探针仅用于精确的接触检测，无视觉外观
  4. STL模型坐标系调整，使探头上端（底部基座）与机器人法兰重合
  5. 保持固定连接到机器人末端法兰
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="probe">
  <!-- 
    探头模型定义
    参数说明:
    - connected_to: 连接到的父链接名称
    - arm_id: 机器人ID，用于命名链接和关节
    - rpy: 探头相对于父链接的旋转角度(roll-pitch-yaw)
    - xyz: 探头相对于父链接的位置偏移
    - tcp_xyz: 工具中心点(TCP)相对于探头的位置偏移
    - tcp_rpy: 工具中心点相对于探头的旋转角度
    - safety_distance: 安全距离，用于碰撞检测
    - gazebo: 是否在Gazebo中仿真
    - description_pkg: 模型文件所在包的名称
  -->
  <xacro:macro name="franka_probe" params="connected_to:='' arm_id:='panda' rpy:='0 0 0' xyz:='0 0 0' tcp_xyz:='0 0 0.109' tcp_rpy:='0 0 0' safety_distance:=0 gazebo:=false description_pkg:=franka_description">
    <xacro:unless value="${connected_to == ''}">
      <!-- 定义探头关节 - 使用fixed类型，确保探头固定连接到机器人末端 -->
      <joint name="${arm_id}_probe_joint" type="fixed">
        <parent link="${connected_to}" />
        <child link="${arm_id}_probe" />
        <!-- 所有情况下使用给定的位置和方向 -->
        <origin xyz="${xyz}" rpy="${rpy}" />
      </joint>
    </xacro:unless>

    <!-- 探头底座链接定义 - 使用STL模型外观，保持圆柱体碰撞模型 -->
    <link name="${arm_id}_probe">
      <!-- 视觉外观 - 使用probe_model的STL网格模型 -->
      <visual>
        <geometry>
          <mesh filename="package://franka_gazebo/models/probe_model/meshes/probe.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="blue">
          <color rgba="0 0 1 1" />
        </material>
        <!-- 调整STL模型位置，使模型上端（底部基座）与法兰重合，xy中心对齐 -->
        <!-- 让探头底部与法兰对齐，Z=0位置对应法兰位置 -->
        <origin xyz="-0.043 -0.051 0" rpy="0 0 0" />
      </visual>
      
      <!-- 碰撞检测几何体 - 保持原有圆柱体模型 -->
      <collision>
        <geometry>
          <cylinder radius="0.03" length="0.109"/>
        </geometry>
        <origin xyz="0 0 0.0545" rpy="0 0 0" />
        <!-- 添加碰撞属性，提高接触精度 -->
        <surface>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>10.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <!-- 物理特性: 质量和惯性 - 保持不变 -->
      <inertial>
        <mass value="0.2" />
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        <origin xyz="0 0 0.0545" rpy="0 0 0" />
      </inertial>
    </link>
    
    <!-- 球形探针链接定义 - 仅用于碰撞检测，无视觉外观 -->
    <link name="${arm_id}_probe_tip">
      <!-- 无视觉外观 - STL模型已包含完整探头形状 -->
      
      <!-- 碰撞检测几何体 - 保持球形模型用于精确接触检测 -->
      <collision>
        <geometry>
          <sphere radius="0.005"/>
        </geometry>
        <!-- 添加碰撞属性，提高接触精度 -->
        <surface>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>10.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.0001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <!-- 物理特性: 质量和惯性 - 保持不变 -->
      <inertial>
        <mass value="0.01" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>

    <!-- 固定连接圆柱体和球体 -->
    <joint name="${arm_id}_probe_to_tip" type="fixed">
      <parent link="${arm_id}_probe" />
      <child link="${arm_id}_probe_tip" />
      <origin xyz="0 0 0.109" rpy="0 0 0" />
    </joint>

    <!-- 定义探头TCP点，与球体探针坐标系重合，用于力反馈和接触检测 -->
    <link name="${arm_id}_probe_tcp" />
    <joint name="${arm_id}_probe_tcp_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${tcp_rpy}" />
      <parent link="${arm_id}_probe_tip" />
      <child link="${arm_id}_probe_tcp" />
    </joint>

    <!-- Gazebo仿真特定参数 -->
    <xacro:if value="${gazebo}">
      <gazebo reference="${arm_id}_probe">
        <material>Gazebo/Blue</material>
        <!-- 钢材料的摩擦系数 -->
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
        <!-- 增加刚度和阻尼，模拟硬质钢材料 -->
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <selfCollide>true</selfCollide>
        <provideFeedback>true</provideFeedback>
        <maxContacts>20</maxContacts>
      </gazebo>
      
      <gazebo reference="${arm_id}_probe_tip">
        <!-- 球形探针无视觉外观，仅用于碰撞检测 -->
        <!-- 球形探针的摩擦系数 -->
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
        <!-- 增加刚度和阻尼，模拟硬质钢材料 -->
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <selfCollide>true</selfCollide>
        <provideFeedback>true</provideFeedback>
        <maxContacts>20</maxContacts>
      </gazebo>
      
      <!-- 传动系统定义 -->
      <transmission name="${arm_id}_probe_joint_transmission">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="${arm_id}_probe_joint">
          <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="${arm_id}_probe_joint_motor">
          <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </actuator>
      </transmission>
    </xacro:if>
  </xacro:macro>
</robot> 