<?xml version="1.0" ?>
<!-- 
  描述: FR3机器人软接触仿真与力估计启动文件
  作者: AIRJASON50
  修改日期: 2024-05-21
  
  此启动文件使用集中的YAML配置文件，同时保留命令行参数覆盖能力
  
  使用示例：
  1. 基本启动：
  roslaunch franka_gazebo fr3_with_force_estimation.launch 
  
  2. 使用命令行参数覆盖配置：
     roslaunch franka_gazebo fr3_with_force_estimation.launch trajectory_type:=figure_eight force_profile_type:=sine
-->
<launch>
  <!-- 加载参数文件 -->
  <rosparam command="load" file="$(find franka_example_controllers)/config/simulation_parameters_config.yaml" />

  <!-- 命令行参数，可覆盖YAML配置 -->
  <!-- 控制模式参数 -->
  <arg name="control_mode" default="0" doc="控制模式 (0=深度控制, 1=力控制)"/>
  
  <!-- 轨迹类型参数 -->
  <arg name="trajectory_type" default="circular" doc="轨迹类型 (circular/rectangular/figure_eight/line/custom)"/>
  
  <!-- 通用轨迹参数 -->
  <arg name="circle_frequency" default="0.3" doc="轨迹运动频率 [Hz]"/>
  <arg name="center_x" default="0.4" doc="轨迹中心点X坐标 [m]"/>
  <arg name="center_y" default="0.0" doc="轨迹中心点Y坐标 [m]"/>
  <arg name="center_z" default="0.405" doc="轨迹中心点Z坐标 [m], 与软块中心一致"/>
  <arg name="speed_factor" default="0.2" doc="轨迹运动速度因子"/>
  
  <!-- 圆形轨迹参数 -->
  <arg name="circle_radius" default="0.1" doc="圆周运动半径 [m]"/>
  <arg name="circle_plane" default="xy" doc="圆周运动平面 (xy/xz/yz)"/>
  
  <!-- 矩形轨迹参数 -->
  <arg name="rect_length" default="0.2" doc="矩形长度 [m]"/>
  <arg name="rect_width" default="0.1" doc="矩形宽度 [m]"/>
  
  <!-- 八字形轨迹参数 -->
  <arg name="eight_radius_x" default="0.1" doc="八字形X轴半径 [m]"/>
  <arg name="eight_radius_y" default="0.05" doc="八字形Y轴半径 [m]"/>
  
  <!-- 直线轨迹参数 -->
  <arg name="line_length" default="0.2" doc="直线长度 [m]"/>
  
  <!-- 自定义轨迹参数 -->
  <arg name="custom_trajectory_file" default="" doc="自定义轨迹文件路径"/>

  <!-- 力轨迹类型参数 -->
  <arg name="force_profile_type" default="constant" doc="力轨迹类型 (constant/sine/step)"/>
  <arg name="force_sine_amplitude" default="2.0" doc="正弦力幅值 [N]"/>
  <arg name="force_sine_frequency" default="1.0" doc="正弦力频率 [Hz]"/>
  <arg name="force_step_time" default="5.0" doc="阶跃力变化时刻 [s]"/>
  <arg name="force_step_value" default="5.0" doc="阶跃后力值 [N]"/>

  <!-- 力噪音参数 -->
  <arg name="force_noise_enable" default="false" doc="是否启用力噪音 (true/false)"/>
  <arg name="force_noise_min" default="1.0" doc="力噪音最小值 [N]"/>
  <arg name="force_noise_max" default="2.0" doc="力噪音最大值 [N]"/>

  <!-- 更新参数服务器，以便命令行参数能覆盖YAML配置 -->
  <param name="/circle_controller/control_mode" value="$(arg control_mode)" />
  <param name="/circle_controller/trajectory_type" value="$(arg trajectory_type)" />
  <param name="/circle_controller/circle_frequency" value="$(arg circle_frequency)" />
  <param name="/circle_controller/center_x" value="$(arg center_x)" />
  <param name="/circle_controller/center_y" value="$(arg center_y)" />
  <param name="/circle_controller/center_z" value="$(arg center_z)" />
  <param name="/circle_controller/speed_factor" value="$(arg speed_factor)" />
  <param name="/circle_controller/circle_radius" value="$(arg circle_radius)" />
  <param name="/circle_controller/circle_plane" value="$(arg circle_plane)" />
  <param name="/circle_controller/rect_length" value="$(arg rect_length)" />
  <param name="/circle_controller/rect_width" value="$(arg rect_width)" />
  <param name="/circle_controller/eight_radius_x" value="$(arg eight_radius_x)" />
  <param name="/circle_controller/eight_radius_y" value="$(arg eight_radius_y)" />
  <param name="/circle_controller/line_length" value="$(arg line_length)" />
  <param name="/circle_controller/custom_trajectory_file" value="$(arg custom_trajectory_file)" />
  <param name="/circle_controller/force_controller/force_profile_type" value="$(arg force_profile_type)" />
  <param name="/circle_controller/force_controller/force_sine_amplitude" value="$(arg force_sine_amplitude)" />
  <param name="/circle_controller/force_controller/force_sine_frequency" value="$(arg force_sine_frequency)" />
  <param name="/circle_controller/force_controller/force_step_time" value="$(arg force_step_time)" />
  <param name="/circle_controller/force_controller/force_step_value" value="$(arg force_step_value)" />
  <param name="/circle_controller/force_controller/force_noise_enable" value="$(arg force_noise_enable)" />
  <param name="/circle_controller/force_controller/force_noise_min" value="$(arg force_noise_min)" />
  <param name="/circle_controller/force_controller/force_noise_max" value="$(arg force_noise_max)" />

  <!-- 启动基础仿真 -->
  <include file="$(find franka_gazebo)/launch/fr3_with_soft_contact.launch">
    <arg name="trajectory_type" value="$(arg trajectory_type)"/>
    <arg name="circle_frequency" value="$(arg circle_frequency)"/>
    <arg name="circle_radius" value="$(arg circle_radius)"/>
    <arg name="circle_plane" value="$(arg circle_plane)"/>
    <arg name="center_x" value="$(arg center_x)"/>
    <arg name="center_y" value="$(arg center_y)"/>
    <arg name="center_z" value="$(arg center_z)"/>
    <arg name="speed_factor" value="$(arg speed_factor)"/>
    <arg name="rect_length" value="$(arg rect_length)"/>
    <arg name="rect_width" value="$(arg rect_width)"/>
    <arg name="eight_radius_x" value="$(arg eight_radius_x)"/>
    <arg name="eight_radius_y" value="$(arg eight_radius_y)"/>
    <arg name="line_length" value="$(arg line_length)"/>
    <arg name="custom_trajectory_file" value="$(arg custom_trajectory_file)"/>
    <arg name="force_profile_type" value="$(arg force_profile_type)"/>
    <arg name="force_sine_amplitude" value="$(arg force_sine_amplitude)"/>
    <arg name="force_sine_frequency" value="$(arg force_sine_frequency)"/>
    <arg name="force_step_time" value="$(arg force_step_time)"/>
    <arg name="force_step_value" value="$(arg force_step_value)"/>
    <arg name="force_noise_enable" value="$(arg force_noise_enable)"/>
    <arg name="force_noise_min" value="$(arg force_noise_min)"/>
    <arg name="force_noise_max" value="$(arg force_noise_max)"/>
    <arg name="disable_rqt" value="true"/>
  </include>
  
  <!-- 启动力曲线绘图（替换原有的rqt节点） -->
  <node name="rqt_force_comparison_plot" pkg="rqt_plot" type="rqt_plot" 
        args="/force_plot/force_z,/force_plot/theoretical_force" 
        output="screen" required="false" launch-prefix="bash -c 'sleep 3; $0 $@' ">
  </node>
  
  <!-- 启动接触状态记录器 -->
  <node pkg="rosbag" type="record" name="force_estimation_recorder" 
        args="-O $(find franka_example_controllers)/data/force_estimation.bag 
              /force_plot/force_z
              /force_plot/theoretical_force
              /franka_state_controller/F_ext
              /circle_controller/equilibrium_pose" />
</launch> 